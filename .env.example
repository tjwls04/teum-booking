# Supabase 프로젝트 URL과 공개 publishable key(sb_publishable_...)입니다.
# R2 클라이언트를 생성할 때 사용합니다. 기존 홈페이지는 환경변수 없이 실행됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# R5 예약 API와 R8 발송 워커용 Supabase secret key(sb_secret_...). 서버에서만 사용합니다.
SUPABASE_SECRET_KEY=
# 배포 시 공개 예약 앱의 최종 HTTPS origin. 끝 슬래시 없이 입력합니다.
BOOKING_APP_ORIGIN=
# 신뢰한 프록시가 매 요청마다 덮어쓰는 단일 클라이언트 IP 헤더 이름. Render 설정은 docs/R9_DEPLOYMENT.md 참고.
BOOKING_TRUSTED_IP_HEADER=

# R8 웹 푸시 키 쌍과 연락처 URI(mailto: 또는 https:).
# VAPID_PUBLIC_KEY만 푸시 설정 화면을 통해 브라우저에 전달됩니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Cron에서 내부 발송 워커를 호출할 때 쓰는 독립 난수 키. 서버에서만 사용합니다.
NOTIFICATION_WORKER_KEY=
